@startuml
skinparam classAttributeIconSize 0

class User {
  - idUser : Long
  - username : String
  - first_name : String
  - last_name : String
  - email : String
  - password : String
}

class Skill {
  - idSkill : int
  - skillName : String
  - description : String
}

class Activity {
  - idActivity : long
  - activityTitle : String
  - activityDescription : String
}

class Offer {
  - idOffer : long
  - startDateTime : DateTime
  - endDateTime : DateTime
}

class Appointment{
  - idAppointment : long
  - startDateTime : DateTime
  - endDateTime : DateTime
}

class Request {
  - idRequest : long
  - startDateTime : DateTime
  - endDateTime : DateTime
}

User "0..*" -- "0..*" Skill
User "1" -- "0..*" Offer
User "1" -- "0..*" Request
Skill "1" -- "0..*" Activity
Appointment "0..1" -- "0..1" Offer
Appointment "0..1" -- "0..1" Request
Offer "0..*" -- "1" Activity
Request "0..*" -- "1" Activity
@enduml