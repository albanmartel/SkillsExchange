@startuml
skinparam classAttributeIconSize 0

enum AssistanceType {
  OFFER
  REQUEST
}

enum AssistanceStatus {
  OPEN
  CANCELLED
  EXPIRED
}

class User {
  - idUser : Long
  - username : String
  - first_name : String
  - last_name : String
  - email : String
  - phone : String
  - password : String
}

class Skill {
  - idSkill : int
  - skillName : String
  - description : String
}

class Activity {
  - idActivity : long
  - activityTitle : String
  - activityDescription : String
}

class Assistance {
  - idAssistance : long
  - typeAssistance : AssistanceType
  - statusAssistance : AssistanceStatus
  - startDateTime : DateTime
  - endDateTime : DateTime
  - creationDateTime: DateTime
  + get_duration() : DateTime
}

class Appointment{
- idAppointment : long
  - isConfirmed : boolean
  - confirmationDateTime : DateTime
  + setConfirmed() : void
}

User "0..*" -- "0..*" Skill
Skill "1" -- "0..*" Activity
Assistance "0..*" -- "1" Activity
User "1" -- "0..*" Assistance : author
User "1" -- "0..*" Appointment : partner
Appointment "0..1" -- "0..*" Assistance

@enduml