@startuml
skinparam classAttributeIconSize 0

enum AssistanceType {
  OFFER
  REQUEST
}

enum AssistanceStatus {
  OPEN
  MATCHED
  CANCELLED
  EXPIRED
}

class User {
  - idUser : Long
  - username : String
  - first_name : String
  - last_name : String
  - email : String
  - phone : String
  - password : String
}

class Skill {
  - idSkill : int
  - skillName : String
  - description : String
}

class Activity {
  - idActivity : long
  - activityTitle : String
  - activityDescription : String
}

class Assistance {
  - idAssistance : long
  - typeAssistance : AssistanceType
  - statusAssistance : AssistanceStatus
  - startDateTime : DateTime
  - endDateTime : DateTime
  - creationDateTime: DateTime
  + get_duration() : DateTime
}

class Offer {
  - idOffer : long
}

class Appointment{
  - idAppointment : long
  - isConfirmedByOfferer : boolean
  - confirmationDateTime: DateTime
}

class Request {
  - idRequest : long
}

EventActivity <|-- Offer
EventActivity <|-- Request

User "0..*" -- "0..*" Skill
Skill "1" -- "0..*" Activity
User "1" -- "0..*" Offer
User "1" -- "0..*" Request
Offer "0..*" -- "1" Activity
Request "0..*" -- "1" Activity
Appointment "0..1" -- "0..1" Offer

@enduml